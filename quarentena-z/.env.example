# ==============================================================================
# QUARENTENA Z — CONFIGURAÇÃO DO SERVIDOR CO-OP & SEGURANÇA (.env.example)
# ==============================================================================

# Porta do Servidor Web, REST API e WebSockets (padrão cloud Render/Railway: 3000 ou fornecida dinamicamente via $PORT)
PORT=3000

# Ambiente de execução ('development' | 'production')
NODE_ENV=production

# CORS Dinâmico: origens permitidas separadas por vírgula (sem barra no final)
# Permite conexão entre o frontend no GitHub Pages e o backend no Render/Railway
ALLOWED_ORIGINS=https://marlonpereiradefreitas-rgb.github.io,http://localhost:3000,http://localhost:8080

# Diretório para armazenamento local seguro do banco de dados (db.json e saves)
DATA_DIR=./data

# Segredo criptográfico do servidor para assinatura HMAC-SHA256 de tokens e partidas
# Deixe vazio para gerar automaticamente uma chave persistente de 256 bits em .server_secret
QZ_SECRET=

# Chave mestra opcional para administração do servidor (endpoints /api/admin/*)
ADMIN_KEY=

# Steamworks App ID (padrão Spacewar 480 para testes locais, substitua pelo ID da loja)
STEAM_APP_ID=480

# Exigir chave de licença DRM comercial (0 = livre/co-op liberado, 1 = exige ativação)
REQUIRE_LICENSE=0
